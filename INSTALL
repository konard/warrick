#!/bin/sh
#
# Warrick Installation Script
# Installs Perl, cURL, Python, and required Perl modules
#

set -e  # Exit on error

# Color output for better readability
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print functions
print_info() {
    printf "${GREEN}[INFO]${NC} %s\n" "$1"
}

print_error() {
    printf "${RED}[ERROR]${NC} %s\n" "$1" >&2
}

print_warning() {
    printf "${YELLOW}[WARNING]${NC} %s\n" "$1"
}

# Detect OS and set package manager
detect_os() {
    print_info "Detecting operating system..."

    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS=$ID
    elif [ "$(uname)" = "Darwin" ]; then
        OS="macos"
    else
        print_error "Unable to detect operating system"
        exit 1
    fi

    print_info "Detected OS: $OS"
}

# Check if running as root (for Linux package managers)
check_sudo() {
    if [ "$OS" != "macos" ] && [ "$(id -u)" -ne 0 ]; then
        print_warning "This script may require sudo privileges for package installation"
        print_info "You may be prompted for your password"
        SUDO="sudo"
    else
        SUDO=""
    fi
}

# Install system packages
install_system_packages() {
    print_info "Installing system packages..."

    case "$OS" in
        ubuntu|debian|linuxmint)
            print_info "Using apt-get package manager"
            $SUDO apt-get update || print_warning "Failed to update package list"
            $SUDO apt-get install -y perl curl libcurl3 libcurl3-dev python python3 2>/dev/null || \
            $SUDO apt-get install -y perl curl libcurl4 libcurl4-openssl-dev python3
            ;;
        fedora|rhel|centos|rocky|almalinux)
            print_info "Using yum/dnf package manager"
            if command -v dnf >/dev/null 2>&1; then
                $SUDO dnf install -y perl curl python python3
            else
                $SUDO yum install -y perl curl python python3
            fi
            ;;
        macos)
            print_info "Using Homebrew package manager"
            if ! command -v brew >/dev/null 2>&1; then
                print_error "Homebrew is not installed"
                print_info "Please install Homebrew from https://brew.sh/"
                print_info "Run: /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
                exit 1
            fi
            brew install perl curl python3 || print_warning "Some packages may already be installed"
            ;;
        *)
            print_error "Unsupported operating system: $OS"
            print_info "Supported systems: Ubuntu, Debian, Fedora, RHEL, CentOS, Rocky Linux, AlmaLinux, macOS"
            exit 1
            ;;
    esac

    print_info "System packages installed successfully"
}

# Check if perl is available
check_perl() {
    if ! command -v perl >/dev/null 2>&1; then
        print_error "Perl is not installed or not in PATH"
        exit 1
    fi
    print_info "Perl version: $(perl -v | grep -oP 'v\d+\.\d+\.\d+' | head -1)"
}

# Check if curl is available
check_curl() {
    if ! command -v curl >/dev/null 2>&1; then
        print_error "cURL is not installed or not in PATH"
        exit 1
    fi
    print_info "cURL version: $(curl --version | head -1)"
}

# Check if python is available
check_python() {
    if command -v python3 >/dev/null 2>&1; then
        print_info "Python version: $(python3 --version)"
    elif command -v python >/dev/null 2>&1; then
        print_info "Python version: $(python --version)"
    else
        print_error "Python is not installed or not in PATH"
        exit 1
    fi
}

# Install Perl modules
install_perl_modules() {
    print_info "Installing Perl modules via CPAN..."

    # List of required modules
    MODULES="HTML::TagParser HTML::LinkExtractor HTTP::Cookies HTTP::Status URI CSS HTTP::Date Getopt::Long"

    # Configure CPAN to be non-interactive if not already configured
    if [ ! -f "$HOME/.cpan/CPAN/MyConfig.pm" ]; then
        print_info "Configuring CPAN for automatic installation..."
        (echo y; echo o conf prerequisites_policy follow; echo o conf commit) | perl -MCPAN -e shell >/dev/null 2>&1 || true
    fi

    # Install each module
    for module in $MODULES; do
        print_info "Installing Perl module: $module"
        perl -MCPAN -e "CPAN::Shell->notest('install', '$module')" || print_warning "Failed to install $module, but continuing..."
    done

    print_info "Perl modules installation completed"
}

# Verify installation
verify_installation() {
    print_info "Verifying installation..."

    FAILED=0

    # Check system dependencies
    check_perl || FAILED=1
    check_curl || FAILED=1
    check_python || FAILED=1

    # Check Perl modules
    MODULES="HTML::TagParser HTML::LinkExtractor HTTP::Cookies HTTP::Status URI CSS HTTP::Date Getopt::Long"
    for module in $MODULES; do
        if perl -M"$module" -e 1 2>/dev/null; then
            print_info "Perl module $module: OK"
        else
            print_warning "Perl module $module: NOT FOUND"
            FAILED=1
        fi
    done

    if [ $FAILED -eq 0 ]; then
        print_info "Installation verification successful!"
        return 0
    else
        print_warning "Some components failed verification"
        return 1
    fi
}

# Main installation process
main() {
    print_info "Starting Warrick installation..."
    echo ""

    detect_os
    check_sudo
    echo ""

    install_system_packages
    echo ""

    print_info "Verifying system dependencies..."
    check_perl
    check_curl
    check_python
    echo ""

    install_perl_modules
    echo ""

    verify_installation
    echo ""

    print_info "Installation complete!"
    print_info "You can now run './TEST' to verify the installation"
    print_info "For usage information, run: perl warrick.pl --help"
}

# Run main function
main
